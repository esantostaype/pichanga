# ---------- Site ----------
# Public origin, used to build absolute og:image / canonical URLs.
NEXT_PUBLIC_SITE_URL="https://pichanga.example.com"

# ---------- Turso (Drizzle) ----------
TURSO_DATABASE_URL="libsql://<your-db>-<org>.turso.io"
TURSO_AUTH_TOKEN="<your-turso-token>"

# ---------- Pusher (realtime) ----------
PUSHER_APP_ID="<app-id>"
PUSHER_SECRET="<secret>"
NEXT_PUBLIC_PUSHER_KEY="<key>"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ---------- Google Places (venue autocomplete) ----------
# Optional. Without it the place form still works, just typed by hand.
# Needs the "Places API (New)" enabled and billing active on the Google Cloud
# project.
#
# This key is used server-side, so restrict it by *API* (Places API New) and,
# if your host has static egress IPs, by IP address. Do NOT use an HTTP
# referrer restriction: those only match browser requests and would reject
# every call made from the server.
GOOGLE_MAPS_API_KEY="<server-side-api-key>"

# ---------- Cloudinary (photos) ----------
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
CLOUDINARY_UPLOAD_FOLDER="pichanga/players"
